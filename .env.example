# 复制为 .env 后按需修改。.env 不要提交到版本库。
#
# 默认情况下这个文件可以完全不动 —— 服务用的是中央气象台的公开接口，
# 不需要注册、不需要任何 Key。

# ---- 数据源 ----
# auto : 配了 AMAP_KEY 就用高德，否则用中央气象台（默认）
# nmc  : 强制用中央气象台公开接口（境内、免注册，无需任何 Key）
# amap : 强制用高德（必须同时配好 AMAP_KEY）
WEATHER_BACKEND=auto

# ---- 高德开放平台（可选，留空即用中央气象台）----
# 如果要用高德，到 https://console.amap.com/dev/key/app 申请「Web 服务」类型的 Key
AMAP_KEY=

# ---- 服务监听 ----
# 裸 IP 若放行 80，就用 80（URL 最干净：http://<IP>/）
# 若被拦截，改成 8080（http://<IP>:8080/），功能完全一致
HOST=0.0.0.0
PORT=80
SITE_TITLE=天气查询

# ---- 缓存（秒）----
# 天气缓存把上游调用量压到约「1 次/城市/10 分钟」
WEATHER_CACHE_TTL=600
IP_CACHE_TTL=3600

# 首页自动刷新间隔（秒），默认与 WEATHER_CACHE_TTL 一致，
# 这样每次自动刷新恰好能拿到新数据。设为 0 可关闭（仍可手动刷新）。
PAGE_REFRESH_SECONDS=600

# ---- 限流（公网 IP 必然被扫描器盯上）----
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_BURST=20

# ---- 并发上限，保护上游配额 ----
MAX_CONCURRENCY=8

# 启动后在后台预热全国城市站点索引（30 多次请求，约 5~8 秒）。
# 关掉的话首次手动搜城市会慢几秒。
WARM_INDEX_ON_STARTUP=true

# ---- 上游超时 ----
NMC_TIMEOUT=6.0
GEOIP_TIMEOUT=5.0

# ---- 安全 ----
# 可信反向代理 IP，逗号分隔。留空 = 直连模式，完全不信任 X-Forwarded-For。
# 直连时千万不要填，否则任何人都能伪造 XFF 指定城市并绕过限流。
TRUSTED_PROXIES=

# 仅本地调试用：允许 ?debug_ip=1.2.3.4 模拟访问者。
# 生产环境必须保持 false，否则会变成一个可任意指定位置的后门。
ALLOW_DEBUG_IP=false
